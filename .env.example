DATABASE_URL=postgres://expresso:expresso@localhost:5432/expresso
PORT=3333
# Endereço do app Next (CORS com cookie). Vários separados por vírgula.
ORIGEM_APP=http://localhost:3000
COOKIE_NOME=expresso_sessao
# Em produção: .seudominio.com (app.seudominio.com e api.seudominio.com). Vazio em desenvolvimento.
COOKIE_DOMINIO=
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSAO_SEGREDO=troque-por-um-segredo-com-pelo-menos-32-caracteres
SESSAO_DIAS=30
# Proxies na frente da API: 1 no Railway; 2 com o front na Vercel repassando /api.
PROXIES_NA_FRENTE=1
